resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 5s;

upstream admin_api_backend {
    zone admin_api_backend 64k;
    server ${BACKEND_UPSTREAM} resolve;
    keepalive 16;
}

upstream website_content_backend {
    zone website_content_backend 64k;
    server ${SITE_BACKEND_UPSTREAM} resolve;
    keepalive 8;
}

server {
    listen 8080 default_server;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;
    index index.html;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Preserve /api while forwarding to Back-Hub. The upstream resolver tracks
    # container IP replacement without restarting the Admin frontend.
    location = /api { return 404; }
    location ^~ /api/ {
        proxy_pass http://admin_api_backend$request_uri;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host ${BACKEND_UPSTREAM};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 60s;
        proxy_buffering off;
        proxy_cache off;
    }

    # Website content API. The browser uses the Admin origin, so the existing
    # admin_session cookie and X-Admin-CSRF header stay same-origin.
    location = /site-api { return 404; }
    location ^~ /site-api/ {
        client_max_body_size 6m;
        rewrite ^/site-api/(.*)$ /api/$1 break;
        proxy_pass http://website_content_backend;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_set_header Host ${SITE_BACKEND_UPSTREAM};
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_buffering off;
        proxy_cache off;
    }

    # A missing hashed chunk must fail instead of returning HTML with a JavaScript MIME type.
    location ^~ /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
    }

    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy same-origin always;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
